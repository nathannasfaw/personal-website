---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} — ${site.tagline}`, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>

<style is:global>
	/* Design tokens. See DESIGN.md for roles and usage rules. */
	:root {
		color-scheme: light;

		--color-bg: #ffffff;
		--color-ink: #111111;
		--color-text: #2b2b2b;
		--color-muted: #5f5f5f;
		--color-line: #e5e5e5;
		--color-tile: #111111;
		--color-tile-text: #ffffff;

		--font-sans: 'Helvetica Neue', Helvetica, Arial, 'Segoe UI', system-ui, sans-serif;
		--font-mono:
			ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', 'Courier New', monospace;

		--text-display: clamp(3rem, 11vw, 8rem);
		--text-xl: clamp(1.5rem, 4vw, 2.25rem);
		--text-lg: 1.25rem;
		--text-md: 1.0625rem;
		--text-body: 0.9375rem;
		--text-sm: 0.8125rem;
		--text-label: 0.875rem;

		--space-1: 0.25rem;
		--space-2: 0.5rem;
		--space-3: 0.75rem;
		--space-4: 1rem;
		--space-5: 1.25rem;
		--space-6: 1.5rem;
		--space-8: 2rem;
		--space-9: 2.25rem;
		--space-12: 3rem;
		--space-16: 4rem;
		--space-24: 6rem;
		--space-32: 8rem;

		--container: 90rem;
		--content: 76rem;
		--gutter: clamp(1rem, 5vw, 4rem);
		--section-gap: var(--space-24);
		--header-height: 5rem;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			color-scheme: dark;

			--color-bg: #0e0e0e;
			--color-ink: #f4f4f4;
			--color-text: #dcdcdc;
			--color-muted: #a1a1a1;
			--color-line: #2a2a2a;
			--color-tile: #f4f4f4;
			--color-tile-text: #0e0e0e;
		}
	}

	@media (min-width: 48rem) {
		:root {
			--section-gap: var(--space-32);
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		/* Keep anchored sections clear of the sticky header. */
		scroll-padding-top: calc(var(--header-height) + var(--space-4));
		-webkit-text-size-adjust: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		margin: 0;
		background-color: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: var(--text-body);
		line-height: 2;
		letter-spacing: 0.02em;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.35;
		text-wrap: balance;
	}

	p {
		margin: 0;
		text-wrap: pretty;
	}

	ul,
	ol {
		margin: 0;
		padding: 0;
	}

	figure {
		margin: 0;
	}

	a {
		color: var(--color-ink);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
	}

	a:hover {
		color: var(--color-muted);
	}

	:focus-visible {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}

	img {
		display: block;
		max-width: 100%;
		height: auto;
	}

	/* Shared scaffolding used by every section component. */
	.container {
		width: 100%;
		max-width: calc(var(--content) + 2 * var(--gutter));
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.section {
		padding-bottom: var(--section-gap);
	}

	.section-label {
		margin-bottom: var(--space-12);
		padding-bottom: var(--space-6);
		border-bottom: 1px solid var(--color-line);
		color: var(--color-muted);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.skip-link {
		position: absolute;
		left: var(--space-4);
		top: -4rem;
		z-index: 20;
		padding: var(--space-2) var(--space-4);
		background-color: var(--color-bg);
		border: 1.5px solid var(--color-ink);
		font-family: var(--font-sans);
		font-weight: 700;
		text-decoration: none;
	}

	.skip-link:focus {
		top: var(--space-4);
	}
</style>
