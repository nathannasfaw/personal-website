---
import type { Project } from '../data/projects';

interface Props extends Project {
  /** 1-based position, shown as a zero-padded index. */
  index: number;
}

const { title, description, tags, github, demo, index } = Astro.props;

// Only render the link column when there is at least one link to show.
const hasLinks = Boolean(github || demo);
---

<li class="row">
  <span class="index" aria-hidden="true">{String(index).padStart(2, '0')}</span>

  <article>
    <h3>{title}</h3>
    <p class="description">{description}</p>
    <ul class="tags" aria-label={`Technologies used in ${title}`}>
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </article>

  {
    hasLinks && (
      <p class="links">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer">
            github<span class="sr-only"> repository for {title}</span>
            <span aria-hidden="true"> ↗</span>
          </a>
        )}
        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer">
            live demo<span class="sr-only"> of {title}</span>
            <span aria-hidden="true"> ↗</span>
          </a>
        )}
      </p>
    )
  }
</li>

<style>
  .row {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-9);
    border-bottom: 1px solid var(--color-line);
  }

  .row:first-child {
    padding-top: 0;
  }

  .index {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  h3 {
    font-size: var(--text-lg);
  }

  .description {
    margin-top: var(--space-3);
    max-width: 65ch;
    color: var(--color-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
    list-style: none;
  }

  .tags li {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-line);
    color: var(--color-text);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .links a {
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 4rem minmax(0, 1fr) 10rem;
      gap: var(--space-8);
    }

    .index {
      line-height: 1.35;
      font-size: var(--text-lg);
    }

    .links {
      flex-direction: column;
      gap: var(--space-2);
      align-items: flex-end;
    }
  }
</style>
