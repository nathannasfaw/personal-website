---
import { experience } from '../data/experience';
---

<section id="experience" class="section" aria-labelledby="experience-heading">
  <div class="container">
    <h2 id="experience-heading" class="section-label">Experience</h2>
    <ol class="grid">
      {
        experience.map((role) => (
          <li class="cell">
            <span class="tile" aria-hidden="true">
              {role.mark}
            </span>
            <article>
              <h3>
                {role.title} — {role.organization}
              </h3>
              <p class="period">{role.period}</p>
              <p class="description">{role.description}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* The grid draws the top and left edges; each cell draws its right and bottom,
     so neighbouring cells share a single 1px line. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
    list-style: none;
  }

  /* Mobile: tile sits above the text so the copy keeps the full cell width. */
  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .tile {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background-color: var(--color-tile);
    color: var(--color-tile-text);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  h3 {
    font-size: var(--text-lg);
  }

  .period {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .description {
    margin-top: var(--space-3);
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .cell {
      flex-direction: row;
      gap: var(--space-5);
      padding: var(--space-9);
    }
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
