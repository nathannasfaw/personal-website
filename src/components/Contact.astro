---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---

<footer id="contact" class="section" aria-labelledby="contact-heading">
  <div class="container">
    <h2 id="contact-heading" class="section-label">Contact</h2>
    <p class="intro">I'd love to hear what you're building.</p>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>

    <SocialLinks />

    <p class="copyright">&copy; {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  .intro {
    color: var(--color-muted);
  }

  .email {
    display: inline-block;
    margin-top: var(--space-3);
    margin-bottom: var(--space-12);
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .copyright {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
